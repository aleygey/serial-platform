{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "serial": {
      "type": "local",
      "command": ["/usr/local/bin/serial", "mcp", "--actor-label", "opencode:workstation"],
      "enabled": true,
      "timeout": 120000
    }
  },
  "permission": {
    "serial_devices": "allow",
    "serial_read": "allow",
    "serial_wait": "allow",
    "serial_search": "allow",
    "serial_monitor_list": "allow",
    "serial_monitor_status": "allow",
    "serial_monitor_incidents": "allow",
    "serial_monitor_start": "ask",
    "serial_monitor_stop": "ask",
    "serial_command": "ask",
    "serial_input": "ask",
    "serial_signal": "ask",
    "serial_trigger": "ask",
    "serial_run_start": "ask",
    "serial_run_end": "ask",
    "serial_release": "allow"
  }
}
